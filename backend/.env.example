# Optional shell configuration: set -a; source .env; set +a
# Django does not automatically load this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to local SQLite when omitted. Docker Compose supplies PostgreSQL.
# DATABASE_URL=postgresql://bindirim:password@localhost:5432/bindirim
# Minutes takes precedence over the legacy PRICE_CHECK_INTERVAL_HOURS setting.
PRICE_CHECK_INTERVAL_MINUTES=15
PRICE_CHECK_LEASE_SECONDS=120
# Production: configure HTTPS at your reverse proxy and set these true.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# Optional price-alert emails (Resend free plan). Keep credentials server-side.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Example sender after verifying your own domain: Bindirim <alerts@your-domain.com>
